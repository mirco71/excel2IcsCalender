{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run All Tests",
            "type": "shell",
            "command": "pytest",
            "args": ["-v"],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "Run Calendar Generator",
            "type": "shell",
            "command": "python",
            "args": ["calendar_generator.py"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}